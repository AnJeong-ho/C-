//使用文件保存成绩单，实现根据学号查找成绩单的功能
#include<stdio.h>
#define L 20      //宏定义最大长度，便于修改
FILE* cardpointer;//指向FILE结构体类型的指针，用于标识和打开文件
struct achievement
{
	int number;
	char name[L];
	int achieve;//成绩
};
//输出检索结果函数
void out_show(struct achievement* card0)
{
	printf("%d\t%s\t%d\n", card0->number, card0->name, card0->achieve);
	//\t是制表符，用于对齐输出
}
void search(int);//检索函数声明
//假设全部成绩单存放在card.dat这个文件中
int main()
{
	int num;
	cardpointer = fopen("card.dat", "rb");//打开文件，以二进制方式只读
	//在工作目录的文件夹（一般也是main.cpp所在文件夹）中检索，若找不到返回null
	//不必从头一个一个输入每个学生的信息，信息已经储存在文件中，用文件指针读取即可
	printf("input the searching student number:");
	scanf("%d", &num);
	while (num != -1)//以输入-1作为终止标志
	{
		search(num);
		printf("input the searching student number:");
		scanf("%d", &num);//重复输入
	}
	printf("End of search");
	fclose(cardpointer);//关闭文件
	return 0;//主函数结束
}
void search(int no)
{
	struct achievement card;
	bool flag = false;
	rewind(cardpointer);//将文件指针重置到文件开头
	while (!feof(cardpointer))//如果指针没到文件末尾，进入循环
	{
		fread(&card, sizeof(struct achievement), 1, cardpointer);
		if (card.number == no)
		{
			printf("Find it\n");
			out_show(&card);
			flag = true;
		}
	}
	if (!flag)//若没有找到
	{
		printf("Cannot find\n");
	}
}

