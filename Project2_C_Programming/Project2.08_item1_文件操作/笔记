//文件定位：用二分法对递增排序二进制整数文件进行检索
#include<stdio.h>
int half_search_of_file(FILE* fp,int key)
{
	int lower, upper, j;//上界，下界，中点
	int v;				//用于从文件读入整数,fread的第一个参数，存储数据
	lower = 0;
	fseek(fp, 0, SEEK_END);//把读写位置指针移动到文件末尾
	upper = ftell(fp) / sizeof(int);//ftell(FILE*)用于计算读写位置指针偏移量
	while (upper - lower >= 0)
	{
		j = (lower + upper) / 2;
		fseek(fp, j * sizeof(int), SEEK_SET);
		fread(&v, sizeof(int), 1, fp);//读取二分点数据
		if (key == v)return j;
		else
		{
			if (key > v)lower = j + 1;
			else upper = j - 1;
		}
	}
	return EOF;
}
